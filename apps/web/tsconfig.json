{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noUncheckedIndexedAccess": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "./app/**/*",
        "./server/**/*",
        "./i18n/**/*",
        "./types/**/*",
        "./nuxt.config.ts",
        "./.nuxt/types/**/*"
    ]
}
